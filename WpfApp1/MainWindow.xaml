<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2026WPF選課系統" Height="560" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頂部學生選擇區 -->
        <Border Grid.Row="0" Background="#F5F3E5" BorderBrush="#DCDAD0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="65,0,0,0">
                <TextBlock Text="學生" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,40,0"/>
                <ComboBox x:Name="StudentComboBox"
                          Width="360" Height="36"
                          FontSize="16" VerticalContentAlignment="Center"
                          Padding="8,0"
                          SelectionChanged="StudentComboBox_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- 下方主要操作區 -->
        <Grid Grid.Row="1" Margin="8,6,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="4.4*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：課程清單 TabControl -->
            <TabControl x:Name="CourseTabControl" Grid.Column="0" FontSize="14" Padding="4">
                <TabItem Header="以教師分類課程">
                    <TreeView x:Name="TeacherTreeView"
                              Background="#EAEFF7"
                              BorderBrush="#828790"
                              FontSize="14"
                              Padding="4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Courses}">
                                <TextBlock Text="{Binding TeacherName}" FontWeight="Bold" Margin="2"/>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" Margin="2"/>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>

                <TabItem Header="所有課程">
                    <ListBox x:Name="AllCoursesListBox"
                             Background="#EAEFF7"
                             BorderBrush="#828790"
                             FontSize="14"
                             Padding="4"/>
                </TabItem>
            </TabControl>

            <!-- 中間：操作按鈕 -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,48,0,0">
                <Button Content="選課" Width="76" Height="38" FontSize="16" Margin="0,0,0,18" Click="EnrollButton_Click"/>
                <Button Content="退選" Width="76" Height="38" FontSize="16" Margin="0,0,0,18" Click="DropButton_Click"/>
                <Button Content="存檔" Width="76" Height="38" FontSize="16" Click="SaveButton_Click"/>
            </StackPanel>

            <!-- 右側：已選課程清單 -->
            <ListBox x:Name="SelectedCoursesListBox"
                     Grid.Column="2"
                     Background="#E8F3F1"
                     BorderBrush="#828790"
                     BorderThickness="1"
                     FontSize="14"
                     Padding="6"/>
        </Grid>
    </Grid>
</Window>